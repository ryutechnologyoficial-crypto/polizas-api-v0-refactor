# Copiar a .env (cp .env.example .env). Valores de EJEMPLO: el servicio arranca con ellos.
# En producción, SECRETO_FIRMA y CLAVE_API_REASEGURO se sustituyen por valores reales
# que nunca se versionan.
DATABASE_URL=sqlite:///polizas.db
SECRETO_FIRMA=cambiar-este-secreto-de-ejemplo
CLAVE_API_REASEGURO=cambiar-esta-clave-de-ejemplo
RUTA_MODELO=modelo.pkl
UMBRAL_ALTO_RIESGO=0.6
# Excel donde se guardan las pólizas con el botón «Guardar en Excel»
RUTA_EXCEL=datos/polizas_guardadas.xlsx
